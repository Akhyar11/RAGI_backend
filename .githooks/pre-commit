#!/bin/bash

echo "🤖 [AGY Agent Audit] Memeriksa staged changes terhadap aturan project (Zero Hardcode & RBAC)..."

STAGED_DIFF=$(git diff --cached)

if [ -z "$STAGED_DIFF" ]; then
    echo "✅ [AGY Agent Audit] Tidak ada perubahan kode yang di-stage."
    exit 0
fi

PROMPT_FILE=$(mktemp)

cat << EOF > "$PROMPT_FILE"
Kamu adalah Agent Penilai Kualitas Kode (Code Auditor).
Periksa Git Diff berikut terhadap aturan Zero Hardcode & RBAC Policy di AGENTS.md.

Aturan Utama:
1. DILARANG ADA HARDCODE string nama modul/role (seperti 'spmb', 'sikeu', 'admin', 'mahasiswa') dalam pengujian logika IF/ELSE atau perbandingan statis.
2. DILARANG menggunakan properti statis user.user_type atau user_type di Controller/Model.
3. Seluruh otorisasi dan relasi WAJIB berbasis ID entitas atau Gate/Policy Laravel.

Git Diff yang di-stage:
\`\`\`diff
$STAGED_DIFF
\`\`\`

Jawab HANYA salah satu:
- PASSED jika kode bersih dari hardcode dan sesuai standar.
- REJECTED: [detail alasan pelanggaran] jika ditemukan hardcode/pelanggaran.
EOF

if command -v agy &> /dev/null; then
    RESULT=$(agy --print "$(cat "$PROMPT_FILE")" 2>&1)
    AGY_EXIT_CODE=$?
else
    AGY_EXIT_CODE=127
fi

if [ $AGY_EXIT_CODE -ne 0 ]; then
    echo "⚠️ [Fallback] agy gagal atau tidak ditemukan. Beralih ke opencode (9router/combo)..."
    RESULT=$(opencode run -m 9router/combo "$(cat "$PROMPT_FILE")" 2>&1)
fi
rm -f "$PROMPT_FILE"

if echo "$RESULT" | grep -qi "REJECTED"; then
    echo ""
    echo "❌ ====================================================="
    echo "❌ COMMIT DITOLAK OLEH AGENT AI (AGY)!"
    echo "❌ ====================================================="
    echo "$RESULT" | grep -i "REJECTED"
    echo "-----------------------------------------------------"
    echo "💡 Harap perbaiki hardcode / pelanggaran di atas sebelum commit."
    echo ""
    exit 1
else
    echo "✅ [AGY Agent Audit] Kode lolos verifikasi AI (Zero Hardcode & RBAC). Commit dilanjutkan."
    exit 0
fi
